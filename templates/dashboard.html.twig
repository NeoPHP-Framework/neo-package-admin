{% extends '@admin/layout.html.twig' %}

{% block page_title %}{{ 'Dashboard'|trans({}, 'admin') }}{% endblock %}

{% block content %}
    <div class="mb-6">
        <h2 class="text-xl font-semibold tracking-tight">{{ 'Welcome to the administration.'|trans({}, 'admin') }}</h2>
        {% set user = app_user() %}
        {% if user %}
            <p class="mt-1 text-sm text-gray-600 dark:text-gray-400">{{ 'You are logged in as {user}.'|trans({user: user.userIdentifier}, 'admin') }}</p>
        {% endif %}
    </div>

    {% if widgets is not empty %}
        <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
            {% for widget in widgets %}
                {% include '@admin/partials/widget.html.twig' with {widget: widget} only %}
            {% endfor %}
        </div>
    {% elseif entities is empty %}
        <div class="rounded-lg border border-dashed border-gray-300 bg-white p-8 text-center dark:border-gray-700 dark:bg-gray-900">
            {{ admin_icon('box', 'mx-auto size-8 text-gray-400') }}
            <p class="mt-3 text-sm font-medium">{{ 'No entity is administered yet.'|trans({}, 'admin') }}</p>
            <p class="mt-1 text-sm text-gray-500 dark:text-gray-400">{{ 'Add entities to the menu of config/packages/admin/admin.yaml.'|trans({}, 'admin') }}</p>
        </div>
    {% else %}
        <div class="grid gap-4 sm:grid-cols-2 xl:grid-cols-3">
            {% for entity in entities %}
                <a href="{{ entity.url }}" class="group flex items-center gap-4 rounded-lg border border-gray-200 bg-white p-5 shadow-sm transition hover:border-indigo-300 hover:shadow dark:border-gray-800 dark:bg-gray-900 dark:hover:border-indigo-500/50">
                    <span class="rounded-md bg-indigo-50 p-2.5 text-indigo-600 dark:bg-indigo-500/10 dark:text-indigo-300">{{ admin_icon(entity.icon) }}</span>
                    <span class="flex-1 truncate font-medium">{{ entity.label|trans({}, 'admin') }}</span>
                    {{ admin_icon('chevron-right', 'size-4 text-gray-400 transition group-hover:translate-x-0.5') }}
                </a>
            {% endfor %}
        </div>
    {% endif %}
{% endblock %}