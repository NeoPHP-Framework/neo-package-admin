<section class="na-stat">
    <div class="na-stat-body">
        {% if icon %}<span class="na-stat-icon">{{ admin_icon(icon) }}</span>{% endif %}
        <div class="min-w-0">
            <p class="na-stat-label">{{ label }}</p>
            <p class="na-stat-value">
                {{ value }}
                {% if trend %}
                    <span class="na-trend na-trend-{{ trend.direction }}">
                        {% if trend.direction == 'up' %}↑{% elseif trend.direction == 'down' %}↓{% endif %} {{ trend.value }}
                    </span>
                {% endif %}
            </p>
            {% if help %}<p class="na-stat-help">{{ help }}</p>{% endif %}
        </div>
    </div>
    {% if url %}
        <a href="{{ url }}" class="na-card-footer">{{ more|trans({}, 'admin') }}</a>
    {% endif %}
</section>